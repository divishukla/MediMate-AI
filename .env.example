# Copy this file to .env and set values in your terminal environment if needed.
# Generate a random long secret for deployments.
MEDIMATE_SECRET_KEY=replace-with-a-long-random-secret
# Optional SMTP settings for email reminders:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=medimate@example.com
# Optional AI helper:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
